DATABASE_URL=postgresql+psycopg://resume:resume_local@127.0.0.1:5433/resume_matcher
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
UPLOAD_DIR=storage/uploads
MAX_FILE_MB=10
EMBEDDING_MODEL=sentence-transformers/all-mpnet-base-v2
# Selectable baseline: sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_CACHE_MB=128
EMBEDDING_BATCH_SIZE=32
SCORING_WEIGHTS={"semantic":0.25,"skill":0.40,"experience":0.25,"education":0.10}
MODEL_CACHE=../.model-cache

# Optional password-reset delivery. Set real values only in your private environment.
# PUBLIC_ORIGIN must be your trusted frontend origin; Render uses its public URL.
PUBLIC_ORIGIN=http://127.0.0.1:5173
BREVO_API_KEY=
PASSWORD_RESET_SENDER=
